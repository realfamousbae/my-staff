# Local development only. PostgreSQL is bound to loopback in compose.yaml.
DATABASE_URL=postgresql://collection:local-development-only@127.0.0.1:55432/collection
PORT=3000
STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR defaults to .local/storage through scripts/local.mjs.

# Nothing is transmitted to an AI provider unless explicitly enabled.
AI_ENABLED=false
AI_DAILY_REQUEST_LIMIT=0
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_IMAGE_MODEL=

# Optional private object storage. Never expose credentials to the mobile app.
# STORAGE_DRIVER=s3
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
