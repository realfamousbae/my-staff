{
  "name": "@my-staff/server",
  "private": true,
  "version": "0.2.0",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx src/db/migrate.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "catalog:grant-editor": "node scripts/catalog-editor.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "pnpm -w exec vitest run apps/server/test",
    "test:watch": "pnpm -w exec vitest apps/server/test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/s3-request-presigner": "3.1127.0",
    "@my-staff/contracts": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "^5.2.1",
    "fflate": "0.8.3",
    "pg": "8.16.3",
    "pg-boss": "12.30.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "5.0.0"
  }
}
