{
  "expo": {
    "name": "My Staff",
    "slug": "my-collection",
    "version": "0.2.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "mycollection",
    "android": {
      "package": "com.mystaff.collection",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7439CF"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешите доступ к камере, чтобы добавлять предметы в коллекцию.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите доступ к фото, чтобы импортировать предметы в коллекцию.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-local-network.cjs"
    ]
  }
}
